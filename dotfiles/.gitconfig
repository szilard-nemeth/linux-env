[url "https://"]
    insteadOf = git://

[push]
    # 'simple' refuses to push when the local branch name differs from its
    # upstream's name — prevents accidentally pushing feature branch commits
    # onto e.g. develop-taikun when the branch was created from that ref.
    # (Was 'upstream', which is what let DEX-22852 nearly push to develop-taikun.)
    default=simple

[branch]
    # Do NOT auto-set upstream when branching from a remote-tracking ref.
    # With the default ('true'), `git checkout -b DEX-XXXXX origin/develop-taikun`
    # silently makes develop-taikun the upstream of DEX-XXXXX — combined with
    # push.default=upstream this would push feature commits onto develop-taikun.
    # 'false' means new branches have no upstream until you explicitly set one
    # (typically via `git push -u`), which is what we want.
    autoSetupMerge = false

[alias]
    co = checkout
    ci = commit
    br = branch
    st = status
    lg= "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
    diffw = diff --color-words=.
    ec = config --global -e
    up = !git pull --rebase --prune $@ && git submodule update --init --recursive
    cob = checkout -b
    cm = !git add -A && git commit -m
    save = !git add -A && git commit -m 'SAVEPOINT'
    wip = !git add -u && git commit -m "WIP"
    undo = reset HEAD~1 --mixed
    amend = commit -a --amend
    wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
    bclean = "!f() { git branch --merged ${1-master} | grep -v " ${1-master}$" | xargs -r git branch -d; }; f"
    bdone = "!f() { git checkout ${1-master} && git up && git bclean ${1-master}; }; f"
    reset-soft = "reset --soft HEAD^"
    remove-commit = "reset --hard HEAD~1"
    cpx = cherry-pick -x
    rbc = rebase --continue
    restore-deleted = !git restore $(git ls-files -d)
    restore-modified = !git restore $(git ls-files -m)

[credential]
    helper = cache --timeout=43200

[diff]
    tool = p4merge
[difftool "p4merge"]
    cmd = /Applications/p4merge.app/Contents/Resources/launchp4merge "\"$REMOTE\"" "\"$LOCAL\""


[merge]
  keepBackup = false
    tool = p4merge
[mergetool "p4merge"]
    cmd = /Applications/p4merge.app/Contents/Resources/launchp4merge "\"$PWD/$BASE\"" "\"$PWD/$REMOTE\"" "\"$PWD/$LOCAL\"" "\"$PWD/$MERGED\""
    keepTemporaries = false
    trustExitCode = false
    keepBackup = false

[pager]                                                                                                                  
    branch = false