{
  "model": "opus[1m]",
  "theme": "auto",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "WebSearch",

      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git ls-remote:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote:*)",
      "Bash(git add docs/security/**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",

      "Bash(./docs/security/tools/render-diagrams.sh:*)",

      "Bash(mkdir docs/security/**)",
      "Bash(ln:*)",
      "Bash(cp /tmp/*:*)",
      "Bash(awk:*)",
      "Bash(python3:*)",
      "Bash(npx --yes @mermaid-js/mermaid-cli:*)",
      "Bash(npx @mermaid-js/mermaid-cli:*)",

      "Bash(bash docs/scripts/threat-modeling/*)",

      "Edit(docs/security/**)",
      "Write(docs/security/**)",
      "Edit(.claude/worktrees/*/docs/security/**)",
      "Write(.claude/worktrees/*/docs/security/**)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Write(.git/**)",
      "Write(.env*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude needs your input\" with title \"Claude Code\" sound name \"Ping\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Turn finished\" with title \"Claude Code\" sound name \"Pop\"'"
          }
        ]
      }
    ]
  }
}